# ============================================================================
# DayBrief AI — environment configuration
# Copy to `.env` and fill in. Never commit the real .env.
# ============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=core.settings.dev   # use core.settings.prod in production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000
TIME_ZONE=UTC
LOG_LEVEL=INFO

# Fernet key for encrypting OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Database (SQLite by default; use Postgres in prod) ---
# DATABASE_URL=postgres://daybrief:daybrief@db:5432/daybrief

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Set True to run background tasks inline without a worker (handy for demos).
CELERY_TASK_ALWAYS_EAGER=True

# --- Google OAuth (Calendar + Gmail) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  {BASE_URL}/auth/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI brief engine ---
# local (default, no key) | groq | gemini | openai | openrouter | ollama | anthropic
# FREE options: Groq (https://console.groq.com/keys, no card) or Gemini
# (https://aistudio.google.com/apikey). Set the provider + key below.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
ANTHROPIC_API_KEY=

# --- Briefing behaviour ---
BRIEF_DEFAULT_TIME=07:30
BRIEF_LOOKAHEAD_HOURS=18
INBOX_LOOKBACK_HOURS=48

# --- Reminders (minutes before an event) ---
REMINDER_OFFSETS_MINUTES=1440,60,10
CALENDAR_POLL_SECONDS=300

# --- Notifications ---
NOTIFY_CHANNELS=email
NOTIFY_WEBHOOK_URL=

# Email (SMTP). In dev, emails print to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DayBrief AI <no-reply@daybrief.ai>
